{% extends 'base.html.twig' %}

{% block title %}Nom d'équipe{% endblock %}

{% block body %}
<style>
    * { text-align: center; }
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
    a { margin: 40px; color: blue; }
</style>

<div class="example-wrapper">
    <h1>Démarrer la partie</h1>
    
    <form action="/menu_enigmes" style="display:inline-block;">
        Nom d'équipe : <input type="text" name="team" required /><br/><br/>
        <button type="submit" class="btn btn-primary">Valider</button><br/><br/>
    </form>
    <form action="/" style="display:inline-block;">
        <button type="submit" class="btn btn-primary">Retour</button><br/><br/>
    </form>
    <form action="/team/new">
        <button type="submit" class="btn btn-primary">Créer une équipe</button>
    </form>
</div>
{% endblock %}