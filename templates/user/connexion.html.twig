{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
<style>
    * { text-align: center; }
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
    a { margin: 40px; color: blue;}
</style>

<div class="example-wrapper">
    <h1>Connexion</h1><br/>
  
    <form action="/teacher"  style="display:inline-block;">
        Identifiant : <input type="text" name="id" required /><br/><br/>
        Mot de passe : <input type="password" name="pass" required /><br/><br/>
        <button type="submit" class="btn btn-primary">Valider</button><br/><br/>
    </form>
    <form action="/" style="display:inline-block;">
        <button type="submit" class="btn btn-primary">Retour</button><br/><br/>
    </form>
    <form action="/user/new">
        <button type="submit" class="btn btn-primary">Créez un compte</button><br/><br/>
    </form>
</div>
{% endblock %}