{% extends 'base.html.twig' %}

{% block title %}Team index{% endblock %}

{% block body %}
    <h1>Liste des équipes</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Position</th>
                <th>Enigme actuelle</th>
                <th>Note</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for team in teams %}
            <tr>
                <td>{{ team.id }}</td>
                <td>{{ team.name }}</td>
                <td>{{ team.position }}</td>
                <td>{{ team.currentEnigma }}</td>
                <td>{{ team.note }}</td>
                <td>
                    <a href="{{ path('app_team_show', {'id': team.id}) }}">voir</a>
                    <a href="{{ path('app_team_edit', {'id': team.id}) }}">modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_team_new') }}">Créer une nouvelle équipe</a>
    <a href="/teacher/gestion">Retour</a>
{% endblock %}
