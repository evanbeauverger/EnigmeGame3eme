{% extends 'base.html.twig' %}

{% block title %}Enigma index{% endblock %}

{% block body %}
    <h1>Gérer les énigmes</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Ordre</th>
                <th>Titre</th>
                <th>Instruction</th>
                <th>Réponse</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for enigma in enigmas %}
            <tr>
                <td>{{ enigma.id }}</td>
                <td>{{ enigma.order }}</td>
                <td>{{ enigma.title }}</td>
                <td>{{ enigma.instruction }}</td>
                <td>{{ enigma.secretcode }}</td>
                <td>
                    <a href="{{ path('app_enigma_show', {'id': enigma.id}) }}">Voir</a>
                    <a href="{{ path('app_enigma_edit', {'id': enigma.id}) }}">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_enigma_new') }}">Créer énigme</a>
    <a href="/teacher/gestion">Retour</a>
{% endblock %}
