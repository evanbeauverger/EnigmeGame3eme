{% extends 'base.html.twig' %}

{% block title %}{{ enigma.title }}{% endblock %}

{% block body %}
<style>
    * { text-align: center; }
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
    a { color: blue; }
    body { background-color: yellow; }
    h3 { margin: 50px; }
    h1 { margin: 40px; }
    button { margin: 15px; }
</style>

<head>
    <title>Énigme sur les IA</title>
</head>

{% if app.user %}
    <form action="/enigma">
        <button type="submit" class="btn btn-primary">Retour à la gestion</button>
    </form>
{% endif %}

<h1>{{ enigma.title }}</h1>
<h3>{{ enigma.instruction }}</h3>

{% for message in app.flashes('error') %}
    <div class="alert alert-danger">{{ message }}</div>
{% endfor %}

<form method="post">
    {% set typeLabel = enigma.type ? enigma.type.label : '' %}

    {% if typeLabel == 'question libre' %}
        <label for="answer">Réponse : </label>
        <input type="text" name="answer" id="answer" required><br/><br/>

    {% elseif typeLabel == 'question à choix' %}
        {% set options = ['A', 'B', 'C', 'D'] %}
        {% for letter in options %}
            {% set value = attribute(enigma, 'option' ~ letter) %}
            {% if value %}
                <input type="radio" name="answer" id="option{{ letter }}" value="{{ value }}" required>
                <label for="option{{ letter }}">{{ letter }} : {{ value }}</label><br/>
            {% endif %}
        {% endfor %}

    {% elseif typeLabel == 'vrai/faux' %}
        <input type="radio" name="answer" id="vrai" value="Vrai" required>
        <label for="vrai">Vrai</label><br/>
        <input type="radio" name="answer" id="faux" value="Faux" required>
        <label for="faux">Faux</label><br/>
    {% endif %}

    <button type="submit" class="btn btn-primary">Valider</button>
</form>

<form action="/menu_enigmes">
    <button type="submit" class="btn btn-primary">Abandonner</button>
</form>

{% for thumb in enigma.thumbnail %}
    <img src="{{ asset('images/' ~ thumb.image) }}" />
{% endfor %}

{% endblock %}
