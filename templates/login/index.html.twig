{% extends 'base.html.twig' %}

{% block body %}
    
    <style>
        * { text-align: center; }
    </style>

    <h1>Connexion</h1>

    {% if error %}
        <div>{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}

    <br/>

    <form action="{{ path('app_login') }}" method="post" style="display:inline-block;">
        <label for="username">Identifiant : </label>
        <input type="text" id="username" name="_username" value="{{ last_username }}" required>
        <br/><br/>

        <label for="password">Mot de passe : </label>
        <input type="password" id="password" name="_password" required>
        <br/><br/>

        <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

        <input type="hidden" name="_target_path" value="/teacher/gestion">

        <button type="submit" class="btn btn-primary">Valider</button>
    </form>

    <form action="/" style="display:inline-block;">
        <button type="submit" class="btn btn-primary">Retour</button>
    </form>
    <br/><br/>
    
    <form action="/user/new">
        <button type="submit" class="btn btn-primary">Créez un compte</button>
    </form>
{% endblock %}
