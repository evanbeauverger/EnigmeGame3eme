{% extends 'base.html.twig' %}

{% block title %}Jeu d'énigmes informatique'{% endblock %}

{% block body %}
<style>
    * { text-align: center; }
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
    a { color: blue; }
</style>

<div class="example-wrapper">
    <h1>Bienvenue dans le jeu d'énigmes informatique</h1><br/>
    <form action="/user/connexion">
        <button type="submit" class="btn btn-primary">Gérer ( enseignant )</button><br/><br/>
    </form>
    <form action="/equipe">
        <button type="submit" class="btn btn-primary">Jouer ( élève )</button><br/><br/>
    </form>
</div>
{% endblock %}
