{% extends 'base.html.twig' %}

{% block title %}Jeu des IA{% endblock %}

{% block body %}
<style>
    div { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif;}
    a { color: blue; }
</style>

<div>
    <h1>Enigmes</h1>
    <ul>
        {% for enigme in enigma %}
            <li>
                {% if enigme.id in resolved %}
                    <form action="/enigma/{{ enigme.id }}">
                        <button type="submit" class="btn btn-success" disabled>
                            {{ enigme.title }}
                        </button>
                    </form>
                {% elseif loop.first or enigma[loop.index0 - 1].id in resolved %}
                    <form action="/enigma/{{ enigme.id }}">
                        <button type="submit" class="btn btn-primary">
                            {{ enigme.title }}
                        </button>
                    </form>
                {% else %}
                    <button class="btn btn-secondary" disabled>
                        {{ enigme.title }}
                    </button>
                {% endif %}
            </li><br/>
        {% endfor %}
    </ul>
    
    <form action="/team/new">
        <button type="submit" class="btn btn-primary">Retour</button>
    </form>
</div>
{% endblock %}
