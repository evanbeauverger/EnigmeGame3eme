{% extends 'base.html.twig' %}

{% block title %}Jeu des IA{% endblock %}

{% block body %}
<style>
    div { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif;}
    a { color: blue; }
</style>

<div>
    <h1>Enigmes</h1>
    <ul>
        {% for enigme in enigma %}
            <li><form action="/enigma/{{enigme.id}}">
                <button type="submit"  class="btn btn-primary">{{ enigme.title }}</button>
            </form></li><br/>
        {% endfor %}
    </ul>
    
    <form action="/equipe">
        <button type="submit" class="btn btn-primary">Retour</button>
    </form>
</div>
{% endblock %}
